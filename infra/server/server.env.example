# Paths and non-secret release/network metadata only. Never put secret values here.
MELLOA_COMPOSE_PROJECT_NAME=melloa-server
MELLOA_IMAGE=melloa-local/server:replace-with-reviewed-commit
MELLOA_BACKUP_IMAGE=melloa-local/backup:replace-with-reviewed-commit
MELLOA_SOURCE_REVISION=replace-with-reviewed-commit
MELLOA_RUNTIME_UID=10001
MELLOA_RUNTIME_GID=10001
MELLOA_STATE_SUBNET=172.30.37.0/28
MELLOA_DATABASE_ADDRESS=172.30.37.2
MELLOA_EGRESS_INTERNAL=false
MELLOA_BUILD_CA_FILE=/etc/ssl/certs/ca-certificates.crt

MELLOA_POSTGRES_ADMIN_PASSWORD_FILE=/etc/melloa/private/postgres-admin-password
MELLOA_POSTGRES_APP_PASSWORD_FILE=/etc/melloa/private/postgres-app-password
MELLOA_POSTGRES_MIGRATION_PASSWORD_FILE=/etc/melloa/private/postgres-migration-password
MELLOA_POSTGRES_BACKUP_PASSWORD_FILE=/etc/melloa/private/postgres-backup-password
MELLOA_RESTIC_PASSWORD_FILE=/etc/melloa/private/restic-password
MELLOA_DATABASE_APPLICATION_DSN_FILE=/etc/melloa/private/database-application-dsn
MELLOA_DATABASE_MIGRATION_DSN_FILE=/etc/melloa/private/database-migration-dsn
MELLOA_OWNER_CREDENTIAL_FILE=/etc/melloa/private/owner-credential
MELLOA_TELEGRAM_OWNER_CONFIG_FILE=/etc/melloa/private/telegram-owner.json
MELLOA_TELEGRAM_BOT_TOKEN_FILE=/etc/melloa/private/telegram-bot-token
MELLOA_CAPABLE_MODEL_CONFIG_FILE=/etc/melloa/private/capable-model.json
MELLOA_ECONOMY_MODEL_CONFIG_FILE=/etc/melloa/private/economy-model.json
MELLOA_MODEL_CREDENTIALS_DIR=/etc/melloa/private/model-credentials
MELLOA_GUARDIAN_HANDOFF_DIR=/var/lib/melloa/guardian-handoff
MELLOA_RUNTIME_STATE_DIR=/var/lib/melloa/runtime-state
MELLOA_BACKUP_REPOSITORY_DIR=/mnt/melloa-off-device-backup
