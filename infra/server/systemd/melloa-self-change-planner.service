[Unit]
Description=Plan owner-requested Melloa self-changes
Documentation=https://github.com/melloa-project/melloa/tree/main/infra/server
Requires=melloa-release-recovery.service
After=melloa-release-recovery.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5
RequiresMountsFor=/etc/melloa /opt/melloa /srv/melloa/planning-source /var/lib/melloa

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/srv/melloa/planning-source
ExecCondition=/usr/local/libexec/melloa/self-change-enabled
ExecStart=/usr/local/libexec/melloa/self-change-plan
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/melloa/self-change.env
LoadCredential=planner-dsn:/etc/melloa/private/database-change-planner-dsn
LoadCredential=codex-api-key:/etc/melloa/private/codex-api-key
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/srv/melloa/planning-source /var/lib/melloa/planning-work /var/lib/melloa/codex-agent
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/podman/podman.sock /srv/melloa/release-source /var/lib/melloa/applying-work /var/lib/melloa/applier-home /var/lib/melloa/release-state /etc/melloa/server.env /etc/melloa/private
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
