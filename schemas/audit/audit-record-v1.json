{
  "$defs": {
    "AuditContent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Action",
          "type": "string"
        },
        "actor_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Actor Id",
          "type": "string"
        },
        "audit_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Audit Id",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "event_type": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Event Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "object_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Object Ids",
          "type": "array"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "audit_id",
        "event_type",
        "occurred_at",
        "actor_id",
        "action",
        "metadata"
      ],
      "title": "AuditContent",
      "type": "object"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/audit-record.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "#/$defs/AuditContent"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "previous_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Hash"
    },
    "record_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Record Hash",
      "type": "string"
    }
  },
  "required": [
    "content",
    "record_hash"
  ],
  "title": "AuditRecord",
  "type": "object"
}
