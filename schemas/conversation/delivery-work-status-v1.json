{
  "$defs": {
    "AuthorizationRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/CanonicalAction"
        },
        "action_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Action Hash",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "delegated_execution_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegated Execution Id"
        },
        "guardian_sequence": {
          "minimum": 1,
          "title": "Guardian Sequence",
          "type": "integer"
        },
        "principal_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Principal Id",
          "type": "string"
        },
        "proposal_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Request Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "proposal_id",
        "principal_id",
        "action",
        "action_hash",
        "guardian_sequence",
        "requested_at"
      ],
      "title": "AuthorizationRequest",
      "type": "object"
    },
    "CanonicalAction": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "estimated_cost_gbp": {
          "default": "0",
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)",
          "title": "Estimated Cost Gbp",
          "type": "string"
        },
        "external_destinations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "External Destinations",
          "type": "array"
        },
        "input_sensitivity": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Sensitivity"
          },
          "title": "Input Sensitivity",
          "type": "array"
        },
        "operation": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Operation",
          "type": "string"
        },
        "output_sensitivity": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Sensitivity"
          },
          "title": "Output Sensitivity",
          "type": "array"
        },
        "purpose": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "resource": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "side_effects": {
          "items": {
            "$ref": "#/$defs/SideEffect"
          },
          "title": "Side Effects",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "operation",
        "resource",
        "purpose",
        "arguments",
        "risk",
        "side_effects"
      ],
      "title": "CanonicalAction",
      "type": "object"
    },
    "DecisionEffect": {
      "enum": [
        "deny",
        "allow",
        "require_approval"
      ],
      "title": "DecisionEffect",
      "type": "string"
    },
    "DeliveryAttempt": {
      "additionalProperties": false,
      "properties": {
        "adapter_metadata": {
          "additionalProperties": true,
          "title": "Adapter Metadata",
          "type": "object"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "attempted_at": {
          "format": "date-time",
          "title": "Attempted At",
          "type": "string"
        },
        "client_adapter": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Client Adapter",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "delivery_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "destination_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Destination Ref",
          "type": "string"
        },
        "message_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Message Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/DeliveryState"
        }
      },
      "required": [
        "delivery_id",
        "message_id",
        "client_adapter",
        "destination_ref",
        "attempt",
        "state",
        "attempted_at"
      ],
      "title": "DeliveryAttempt",
      "type": "object"
    },
    "DeliveryExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "action_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Action Hash",
          "type": "string"
        },
        "action_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Action Id",
          "type": "string"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "delivery_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "operation": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Operation",
          "type": "string"
        },
        "result_summary": {
          "additionalProperties": true,
          "title": "Result Summary",
          "type": "object"
        }
      },
      "required": [
        "action_id",
        "decision_id",
        "action_hash",
        "capability_id",
        "operation",
        "delivery_id",
        "executed_at"
      ],
      "title": "DeliveryExecutionReceipt",
      "type": "object"
    },
    "DeliveryState": {
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "expired"
      ],
      "title": "DeliveryState",
      "type": "string"
    },
    "DeliveryWorkAttempt": {
      "additionalProperties": false,
      "properties": {
        "action_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Action Hash",
          "type": "string"
        },
        "adapter_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryAttempt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "attempt_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "authorization_request_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Authorization Request Id",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "execution_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryExecutionReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Message Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/DeliveryWorkOutcome"
        },
        "policy_decision_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Policy Decision Id",
          "type": "string"
        },
        "retry_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry At"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "work_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Work Id",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "work_id",
        "message_id",
        "attempt",
        "authorization_request_id",
        "policy_decision_id",
        "action_hash",
        "outcome",
        "started_at",
        "completed_at"
      ],
      "title": "DeliveryWorkAttempt",
      "type": "object"
    },
    "DeliveryWorkOutcome": {
      "enum": [
        "succeeded",
        "retry_scheduled",
        "dead"
      ],
      "title": "DeliveryWorkOutcome",
      "type": "string"
    },
    "DeliveryWorkResumption": {
      "additionalProperties": false,
      "properties": {
        "added_attempts": {
          "maximum": 100,
          "minimum": 1,
          "title": "Added Attempts",
          "type": "integer"
        },
        "authorization_request": {
          "$ref": "#/$defs/AuthorizationRequest"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "message_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Message Id",
          "type": "string"
        },
        "policy_decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "prior_attempts": {
          "minimum": 1,
          "title": "Prior Attempts",
          "type": "integer"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "requested_by": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Requested By",
          "type": "string"
        },
        "resumption_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Resumption Id",
          "type": "string"
        },
        "work_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Work Id",
          "type": "string"
        }
      },
      "required": [
        "resumption_id",
        "work_id",
        "message_id",
        "requested_by",
        "requested_at",
        "prior_attempts",
        "added_attempts",
        "authorization_request",
        "policy_decision"
      ],
      "title": "DeliveryWorkResumption",
      "type": "object"
    },
    "DeliveryWorkState": {
      "enum": [
        "ready",
        "running",
        "completed",
        "dead",
        "cancelled"
      ],
      "title": "DeliveryWorkState",
      "type": "string"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "action_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Action Hash",
          "type": "string"
        },
        "constraints": {
          "additionalProperties": true,
          "title": "Constraints",
          "type": "object"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/DecisionEffect"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "obligations": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          },
          "title": "Obligations",
          "type": "array"
        },
        "policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "request_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "request_id",
        "action_hash",
        "effect",
        "policy_version",
        "reason_codes",
        "decided_at"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "r0_read_only_local",
        "r1_reversible_internal",
        "r2_external_reputational",
        "r3_destructive_privileged",
        "r4_irreversible_high_consequence"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "SideEffect": {
      "enum": [
        "internal_write",
        "local_file_write",
        "external_read",
        "external_communication",
        "external_write",
        "data_deletion",
        "credential_use",
        "credential_reveal",
        "host_code_execution",
        "guardian_control",
        "governance_change",
        "audit_deletion"
      ],
      "title": "SideEffect",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/delivery-work-status.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Action Hash",
      "type": "string"
    },
    "attempt_count": {
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "attempts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DeliveryWorkAttempt"
      },
      "title": "Attempts",
      "type": "array"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "client_adapter": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Client Adapter",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "current_policy_decision_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Current Policy Decision Id",
      "type": "string"
    },
    "destination_ref": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Destination Ref",
      "type": "string"
    },
    "last_error_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error Code"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "max_attempts": {
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "message_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Message Id",
      "type": "string"
    },
    "resumptions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DeliveryWorkResumption"
      },
      "title": "Resumptions",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/DeliveryWorkState"
    },
    "thread_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Thread Id",
      "type": "string"
    },
    "work_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "work_id",
    "thread_id",
    "message_id",
    "client_adapter",
    "destination_ref",
    "action_hash",
    "current_policy_decision_id",
    "state",
    "attempt_count",
    "max_attempts",
    "available_at"
  ],
  "title": "DeliveryWorkStatus",
  "type": "object"
}
