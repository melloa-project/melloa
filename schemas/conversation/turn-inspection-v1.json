{
  "$defs": {
    "AssertionStatus": {
      "enum": [
        "provisional",
        "active",
        "confirmed",
        "disputed",
        "superseded",
        "retracted",
        "expired"
      ],
      "title": "AssertionStatus",
      "type": "string"
    },
    "ConversationMessage": {
      "additionalProperties": false,
      "properties": {
        "author_principal_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Author Principal Id",
          "type": "string"
        },
        "citation_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Citation Ids",
          "type": "array"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "corrects_message_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrects Message Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "delivery_state": {
          "$ref": "#/$defs/DeliveryState"
        },
        "message_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Message Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/MessagePart"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "reply_to_message_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply To Message Id"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "source_client": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Source Client",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Thread Id",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "thread_id",
        "author_principal_id",
        "source_client",
        "parts",
        "delivery_state",
        "sensitivity",
        "created_at",
        "observed_at"
      ],
      "title": "ConversationMessage",
      "type": "object"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "decision_record": {
          "additionalProperties": true,
          "title": "Decision Record",
          "type": "object"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "executed_action_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Executed Action Ids",
          "type": "array"
        },
        "model_run_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Model Run Ids",
          "type": "array"
        },
        "output_message_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Output Message Ids",
          "type": "array"
        },
        "policy_decision_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Policy Decision Ids",
          "type": "array"
        },
        "proposed_action_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Proposed Action Ids",
          "type": "array"
        },
        "retrieval_manifest_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Manifest Id"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Thread Id",
          "type": "string"
        },
        "triggering_message_ids": {
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Triggering Message Ids",
          "type": "array"
        },
        "turn_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "thread_id",
        "triggering_message_ids",
        "decision_record",
        "started_at"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "DeliveryState": {
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "expired"
      ],
      "title": "DeliveryState",
      "type": "string"
    },
    "EpistemicStatus": {
      "enum": [
        "observation",
        "interpretation",
        "belief",
        "owner_confirmed",
        "correction"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "MemoryCitation": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "assertion_status": {
          "$ref": "#/$defs/AssertionStatus"
        },
        "citation_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Citation Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "epistemic_status": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "predicate": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Predicate",
          "type": "string"
        },
        "provenance_edge_ids": {
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Provenance Edge Ids",
          "type": "array"
        },
        "rank_reasons": {
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Rank Reasons",
          "type": "array"
        },
        "rank_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rank Score",
          "type": "number"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "source_authority": {
          "$ref": "#/$defs/TrustLabel"
        },
        "value": {
          "additionalProperties": true,
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "citation_id",
        "assertion_id",
        "predicate",
        "value",
        "epistemic_status",
        "assertion_status",
        "confidence",
        "source_authority",
        "sensitivity",
        "observed_at",
        "provenance_edge_ids",
        "rank_score",
        "rank_reasons"
      ],
      "title": "MemoryCitation",
      "type": "object"
    },
    "MessageKind": {
      "enum": [
        "text",
        "attachment",
        "system_notice"
      ],
      "title": "MessageKind",
      "type": "string"
    },
    "MessagePart": {
      "additionalProperties": false,
      "properties": {
        "attachment_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attachment Id"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "kind": {
          "$ref": "#/$defs/MessageKind"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "kind"
      ],
      "title": "MessagePart",
      "type": "object"
    },
    "ModelAttemptOutcome": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "ModelAttemptOutcome",
      "type": "string"
    },
    "ModelResult": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelRouteAttempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "cost_gbp": {
          "minimum": 0.0,
          "title": "Cost Gbp",
          "type": "number"
        },
        "external_disclosure": {
          "title": "External Disclosure",
          "type": "boolean"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Request Id",
          "type": "string"
        },
        "result_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Result Id",
          "type": "string"
        },
        "route_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Route Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "request_id",
        "route_id",
        "provider_id",
        "model_id",
        "output",
        "input_tokens",
        "output_tokens",
        "cost_gbp",
        "started_at",
        "completed_at",
        "external_disclosure"
      ],
      "title": "ModelResult",
      "type": "object"
    },
    "ModelRouteAttempt": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "external_disclosure": {
          "title": "External Disclosure",
          "type": "boolean"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ModelAttemptOutcome"
        },
        "processing_location": {
          "$ref": "#/$defs/ProcessingLocation"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "route_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Route Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "provider_id",
        "model_id",
        "processing_location",
        "outcome",
        "started_at",
        "completed_at",
        "external_disclosure"
      ],
      "title": "ModelRouteAttempt",
      "type": "object"
    },
    "ProcessingLocation": {
      "enum": [
        "device",
        "private_network",
        "approved_provider"
      ],
      "title": "ProcessingLocation",
      "type": "string"
    },
    "RetrievalManifest": {
      "additionalProperties": false,
      "properties": {
        "allowed_sensitivities": {
          "items": {
            "$ref": "#/$defs/Sensitivity"
          },
          "minItems": 1,
          "title": "Allowed Sensitivities",
          "type": "array",
          "uniqueItems": true
        },
        "candidate_assertion_ids": {
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Candidate Assertion Ids",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/MemoryCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "excluded_assertion_ids": {
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Excluded Assertion Ids",
          "type": "array"
        },
        "external_disclosure": {
          "title": "External Disclosure",
          "type": "boolean"
        },
        "manifest_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/RetrievalMethod"
          },
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "purpose": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Purpose",
          "type": "string"
        },
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "requester_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Requester Id",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "requester_id",
        "subject_id",
        "purpose",
        "query_hash",
        "allowed_sensitivities",
        "methods",
        "candidate_assertion_ids",
        "citations",
        "excluded_assertion_ids",
        "created_at",
        "external_disclosure"
      ],
      "title": "RetrievalManifest",
      "type": "object"
    },
    "RetrievalMethod": {
      "enum": [
        "exact_relational",
        "full_text_candidate",
        "vector_candidate"
      ],
      "title": "RetrievalMethod",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "TrustLabel": {
      "enum": [
        "owner_authored",
        "trusted_system",
        "trusted_capability_metadata",
        "untrusted_external",
        "untrusted_sensor_derived",
        "model_generated",
        "generated_code",
        "signed_system_artifact"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/conversation-turn-inspection.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "model_result": {
      "$ref": "#/$defs/ModelResult"
    },
    "output_message": {
      "$ref": "#/$defs/ConversationMessage"
    },
    "retrieval_manifest": {
      "$ref": "#/$defs/RetrievalManifest"
    },
    "turn": {
      "$ref": "#/$defs/ConversationTurn"
    }
  },
  "required": [
    "turn",
    "retrieval_manifest",
    "model_result",
    "output_message"
  ],
  "title": "ConversationTurnInspection",
  "type": "object"
}
