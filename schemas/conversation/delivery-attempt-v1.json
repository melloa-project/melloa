{
  "$defs": {
    "DeliveryState": {
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "expired"
      ],
      "title": "DeliveryState",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/delivery-attempt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_metadata": {
      "additionalProperties": true,
      "title": "Adapter Metadata",
      "type": "object"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "attempted_at": {
      "format": "date-time",
      "title": "Attempted At",
      "type": "string"
    },
    "client_adapter": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Client Adapter",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "delivery_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Delivery Id",
      "type": "string"
    },
    "destination_ref": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Destination Ref",
      "type": "string"
    },
    "message_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Message Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/DeliveryState"
    }
  },
  "required": [
    "delivery_id",
    "message_id",
    "client_adapter",
    "destination_ref",
    "attempt",
    "state",
    "attempted_at"
  ],
  "title": "DeliveryAttempt",
  "type": "object"
}
