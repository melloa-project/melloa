{
  "$id": "https://schemas.melloa.dev/v1/conversation-processing-resumption.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "added_attempts": {
      "maximum": 100,
      "minimum": 1,
      "title": "Added Attempts",
      "type": "integer"
    },
    "message_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Message Id",
      "type": "string"
    },
    "prior_attempts": {
      "minimum": 1,
      "title": "Prior Attempts",
      "type": "integer"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Requested By",
      "type": "string"
    },
    "resumption_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Resumption Id",
      "type": "string"
    },
    "work_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "resumption_id",
    "work_id",
    "message_id",
    "requested_by",
    "requested_at",
    "prior_attempts",
    "added_attempts"
  ],
  "title": "ConversationProcessingResumption",
  "type": "object"
}
