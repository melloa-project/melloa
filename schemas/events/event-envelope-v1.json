{
  "$defs": {
    "EpistemicStatus": {
      "enum": [
        "observation",
        "interpretation",
        "belief",
        "owner_confirmed",
        "correction"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "EventAlternative": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "claim",
        "confidence"
      ],
      "title": "EventAlternative",
      "type": "object"
    },
    "EventIntegrity": {
      "additionalProperties": false,
      "properties": {
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        }
      },
      "required": [
        "payload_hash"
      ],
      "title": "EventIntegrity",
      "type": "object"
    },
    "EventProducer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Component",
          "type": "string"
        },
        "configuration_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Version"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_route": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Route"
        },
        "prompt_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "EventProducer",
      "type": "object"
    },
    "EventSource": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "execution_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Id"
        },
        "observation_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "capability_id"
      ],
      "title": "EventSource",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "blob_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Blob Hash",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "media_type": {
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "blob_hash",
        "media_type"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "TrustLabel": {
      "enum": [
        "owner_authored",
        "trusted_system",
        "trusted_capability_metadata",
        "untrusted_external",
        "untrusted_sensor_derived",
        "model_generated",
        "generated_code",
        "signed_system_artifact"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/event-envelope.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EventAlternative"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "epistemic_status": {
      "$ref": "#/$defs/EpistemicStatus"
    },
    "event_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Event Type",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence",
      "type": "array"
    },
    "integrity": {
      "$ref": "#/$defs/EventIntegrity"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/EventProducer"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "retention_policy": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Retention Policy",
      "type": "string"
    },
    "schema_version": {
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    },
    "subject_ids": {
      "default": [],
      "items": {
        "maxLength": 65,
        "minLength": 35,
        "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Subject Ids",
      "type": "array"
    },
    "trust": {
      "$ref": "#/$defs/TrustLabel"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "recorded_at",
    "source",
    "producer",
    "epistemic_status",
    "sensitivity",
    "trust",
    "retention_policy",
    "payload",
    "integrity"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
