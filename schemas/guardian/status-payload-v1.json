{
  "$defs": {
    "GuardianMode": {
      "enum": [
        "normal",
        "no-actions",
        "read-only",
        "offline",
        "stopped",
        "recovery"
      ],
      "title": "GuardianMode",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/guardian-status-payload.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed_at": {
      "format": "date-time",
      "title": "Changed At",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Instance Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/GuardianMode"
    },
    "previous_receipt_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Receipt Hash"
    },
    "protocol_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Reason Code",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "instance_id",
    "mode",
    "sequence",
    "changed_at",
    "reason_code"
  ],
  "title": "GuardianStatusPayload",
  "type": "object"
}
