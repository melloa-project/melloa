{
  "$id": "https://schemas.melloa.dev/v1/guardian-signed-status.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519",
      "default": "Ed25519",
      "title": "Algorithm",
      "type": "string"
    },
    "envelope_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Envelope Version",
      "type": "string"
    },
    "key_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Key Id",
      "type": "string"
    },
    "payload": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Payload",
      "type": "string"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "key_id",
    "payload",
    "signature"
  ],
  "title": "SignedGuardianStatus",
  "type": "object"
}
