{
  "$defs": {
    "ComponentHealth": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/HealthCategory"
        },
        "component_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Component Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/HealthState"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "component_id",
        "category",
        "state",
        "required",
        "observed_at",
        "summary"
      ],
      "title": "ComponentHealth",
      "type": "object"
    },
    "HealthCategory": {
      "enum": [
        "application",
        "worker",
        "database",
        "queue",
        "provider",
        "camera",
        "storage",
        "backup",
        "deployment"
      ],
      "title": "HealthCategory",
      "type": "string"
    },
    "HealthState": {
      "enum": [
        "healthy",
        "degraded",
        "unavailable",
        "disabled"
      ],
      "title": "HealthState",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/owner-health.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentHealth"
      },
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "overall_state": {
      "$ref": "#/$defs/HealthState"
    },
    "owner_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Owner Id",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "generated_at",
    "overall_state",
    "components"
  ],
  "title": "OwnerHealthReport",
  "type": "object"
}
