{
  "$defs": {
    "OwnerTimelineEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Kind",
          "type": "string"
        },
        "message_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "summary": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "thread_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "turn_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        },
        "work_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Id"
        }
      },
      "required": [
        "event_id",
        "kind",
        "occurred_at",
        "source",
        "summary"
      ],
      "title": "OwnerTimelineEvent",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/owner-timeline.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "coverage": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/OwnerTimelineEvent"
      },
      "title": "Entries",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "matching_events": {
      "minimum": 0,
      "title": "Matching Events",
      "type": "integer"
    },
    "owner_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Owner Id",
      "type": "string"
    },
    "total_events": {
      "minimum": 0,
      "title": "Total Events",
      "type": "integer"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "window_start",
    "window_end",
    "generated_at",
    "total_events",
    "matching_events",
    "truncated",
    "coverage",
    "limitations",
    "entries"
  ],
  "title": "OwnerTimelineReport",
  "type": "object"
}
