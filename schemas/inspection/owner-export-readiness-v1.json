{
  "$defs": {
    "EncryptedExportPackageReadiness": {
      "additionalProperties": false,
      "properties": {
        "cipher": {
          "anyOf": [
            {
              "const": "aes-256-gcm",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cipher"
        },
        "kdf": {
          "anyOf": [
            {
              "const": "scrypt",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kdf"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "package_command": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Command"
        },
        "package_format_id": {
          "default": "melloa.encrypted-owner-export-package",
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Package Format Id",
          "type": "string"
        },
        "package_format_version": {
          "default": "1.0.0",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Package Format Version",
          "type": "string"
        },
        "passphrase_file_required": {
          "title": "Passphrase File Required",
          "type": "boolean"
        },
        "required_file_mode": {
          "anyOf": [
            {
              "const": "0600",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required File Mode"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        },
        "validation_command": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Command"
        }
      },
      "required": [
        "supported",
        "passphrase_file_required"
      ],
      "title": "EncryptedExportPackageReadiness",
      "type": "object"
    },
    "ExportCoverageItem": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "estimated_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Records"
        },
        "group_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Group Id",
          "type": "string"
        },
        "included": {
          "title": "Included",
          "type": "boolean"
        },
        "status_reason": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Status Reason",
          "type": "string"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "included",
        "summary",
        "status_reason"
      ],
      "title": "ExportCoverageItem",
      "type": "object"
    },
    "ExportValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "implemented": {
          "title": "Implemented",
          "type": "boolean"
        },
        "status_reason": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Status Reason",
          "type": "string"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "implemented",
        "summary",
        "status_reason"
      ],
      "title": "ExportValidationCheck",
      "type": "object"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/owner-export-readiness.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cli_command": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Cli Command",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/ExportCoverageItem"
      },
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "encrypted": {
      "title": "Encrypted",
      "type": "boolean"
    },
    "encrypted_package": {
      "$ref": "#/$defs/EncryptedExportPackageReadiness"
    },
    "format_id": {
      "default": "melloa.canonical-owner-export",
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Format Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "includes_blobs": {
      "title": "Includes Blobs",
      "type": "boolean"
    },
    "includes_sql_snapshot": {
      "title": "Includes Sql Snapshot",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "owner_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Owner Id",
      "type": "string"
    },
    "validation_checks": {
      "items": {
        "$ref": "#/$defs/ExportValidationCheck"
      },
      "minItems": 1,
      "title": "Validation Checks",
      "type": "array"
    },
    "validation_command": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Validation Command",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "generated_at",
    "cli_command",
    "validation_command",
    "encrypted",
    "includes_sql_snapshot",
    "includes_blobs",
    "encrypted_package",
    "coverage",
    "validation_checks",
    "limitations"
  ],
  "title": "OwnerExportReadinessReport",
  "type": "object"
}
