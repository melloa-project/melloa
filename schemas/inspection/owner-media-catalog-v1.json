{
  "$defs": {
    "HealthState": {
      "enum": [
        "healthy",
        "degraded",
        "unavailable",
        "disabled"
      ],
      "title": "HealthState",
      "type": "string"
    },
    "MediaItemMetadata": {
      "additionalProperties": false,
      "properties": {
        "captured_from": {
          "format": "date-time",
          "title": "Captured From",
          "type": "string"
        },
        "captured_to": {
          "format": "date-time",
          "title": "Captured To",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "disclosure_record_ids": {
          "default": [],
          "items": {
            "maxLength": 65,
            "minLength": 35,
            "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Disclosure Record Ids",
          "type": "array"
        },
        "event_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Event Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "interpretation_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpretation Confidence"
        },
        "media_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Media Id",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        },
        "owner_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Owner Id",
          "type": "string"
        },
        "retained_at": {
          "format": "date-time",
          "title": "Retained At",
          "type": "string"
        },
        "retention_policy": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Retention Policy",
          "type": "string"
        },
        "retention_state": {
          "$ref": "#/$defs/MediaRetentionState"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_capability_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Source Capability Id",
          "type": "string"
        }
      },
      "required": [
        "media_id",
        "owner_id",
        "source_capability_id",
        "event_id",
        "media_type",
        "content_hash",
        "sensitivity",
        "captured_from",
        "captured_to",
        "retention_policy",
        "retained_at",
        "expires_at",
        "size_bytes",
        "retention_state"
      ],
      "title": "MediaItemMetadata",
      "type": "object"
    },
    "MediaRetentionState": {
      "enum": [
        "retained",
        "deletion_pending",
        "deleted",
        "expired"
      ],
      "title": "MediaRetentionState",
      "type": "string"
    },
    "MediaSourceStatus": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "capture_enabled": {
          "title": "Capture Enabled",
          "type": "boolean"
        },
        "health_state": {
          "$ref": "#/$defs/HealthState"
        },
        "installed": {
          "title": "Installed",
          "type": "boolean"
        },
        "last_capture_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Capture At"
        },
        "missing_intervals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MissingMediaInterval"
          },
          "title": "Missing Intervals",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "status_reason": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Status Reason",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "installed",
        "capture_enabled",
        "health_state",
        "observed_at",
        "status_reason"
      ],
      "title": "MediaSourceStatus",
      "type": "object"
    },
    "MissingMediaInterval": {
      "additionalProperties": false,
      "properties": {
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "ended_at",
        "reason_code"
      ],
      "title": "MissingMediaInterval",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/owner-media-catalog.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capture_enabled": {
      "title": "Capture Enabled",
      "type": "boolean"
    },
    "content_endpoint_available": {
      "const": false,
      "default": false,
      "title": "Content Endpoint Available",
      "type": "boolean"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/MediaItemMetadata"
      },
      "title": "Items",
      "type": "array"
    },
    "owner_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Owner Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/MediaSourceStatus"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "owner_id",
    "generated_at",
    "capture_enabled",
    "sources",
    "items"
  ],
  "title": "OwnerMediaCatalog",
  "type": "object"
}
