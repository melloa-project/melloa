{
  "$defs": {
    "DecisionEffect": {
      "enum": [
        "deny",
        "allow",
        "require_approval"
      ],
      "title": "DecisionEffect",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/policy-decision.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Action Hash",
      "type": "string"
    },
    "constraints": {
      "additionalProperties": true,
      "title": "Constraints",
      "type": "object"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Decision Id",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/DecisionEffect"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "obligations": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "title": "Obligations",
      "type": "array"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "request_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "request_id",
    "action_hash",
    "effect",
    "policy_version",
    "reason_codes",
    "decided_at"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
