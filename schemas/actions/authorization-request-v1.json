{
  "$defs": {
    "CanonicalAction": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "estimated_cost_gbp": {
          "default": "0",
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)",
          "title": "Estimated Cost Gbp",
          "type": "string"
        },
        "external_destinations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "External Destinations",
          "type": "array"
        },
        "input_sensitivity": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Sensitivity"
          },
          "title": "Input Sensitivity",
          "type": "array"
        },
        "operation": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Operation",
          "type": "string"
        },
        "output_sensitivity": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Sensitivity"
          },
          "title": "Output Sensitivity",
          "type": "array"
        },
        "purpose": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "resource": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "side_effects": {
          "items": {
            "$ref": "#/$defs/SideEffect"
          },
          "title": "Side Effects",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "operation",
        "resource",
        "purpose",
        "arguments",
        "risk",
        "side_effects"
      ],
      "title": "CanonicalAction",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "r0_read_only_local",
        "r1_reversible_internal",
        "r2_external_reputational",
        "r3_destructive_privileged",
        "r4_irreversible_high_consequence"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "SideEffect": {
      "enum": [
        "internal_write",
        "local_file_write",
        "external_read",
        "external_communication",
        "external_write",
        "data_deletion",
        "credential_use",
        "credential_reveal",
        "host_code_execution",
        "guardian_control",
        "governance_change",
        "audit_deletion"
      ],
      "title": "SideEffect",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/authorization-request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/CanonicalAction"
    },
    "action_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Action Hash",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "delegated_execution_id": {
      "anyOf": [
        {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delegated Execution Id"
    },
    "guardian_sequence": {
      "minimum": 1,
      "title": "Guardian Sequence",
      "type": "integer"
    },
    "principal_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Principal Id",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "proposal_id",
    "principal_id",
    "action",
    "action_hash",
    "guardian_sequence",
    "requested_at"
  ],
  "title": "AuthorizationRequest",
  "type": "object"
}
