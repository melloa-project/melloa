{
  "$defs": {
    "AssertionContentDeletionTombstone": {
      "additionalProperties": false,
      "description": "Content-free evidence that one assertion value was intentionally removed.",
      "properties": {
        "assertion_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "deleted_at": {
          "format": "date-time",
          "title": "Deleted At",
          "type": "string"
        },
        "deleted_by_record_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Deleted By Record Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "owner_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Owner Id",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "rebuild_work_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Rebuild Work Id",
          "type": "string"
        },
        "retained_at": {
          "format": "date-time",
          "title": "Retained At",
          "type": "string"
        },
        "retention_policy": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Retention Policy",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "tombstone_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Tombstone Id",
          "type": "string"
        }
      },
      "required": [
        "tombstone_id",
        "assertion_id",
        "owner_id",
        "deleted_by_record_id",
        "content_hash",
        "size_bytes",
        "retention_policy",
        "retained_at",
        "deleted_at",
        "reason_code",
        "rebuild_work_id"
      ],
      "title": "AssertionContentDeletionTombstone",
      "type": "object"
    },
    "AssertionDerivedRebuildWork": {
      "additionalProperties": false,
      "description": "Content-free work request to purge and rebuild assertion-derived data.",
      "properties": {
        "assertion_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "requested_by_record_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Requested By Record Id",
          "type": "string"
        },
        "tombstone_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Tombstone Id",
          "type": "string"
        },
        "work_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Work Id",
          "type": "string"
        },
        "work_type": {
          "const": "memory.assertion-derived-rebuild",
          "default": "memory.assertion-derived-rebuild",
          "title": "Work Type",
          "type": "string"
        }
      },
      "required": [
        "work_id",
        "assertion_id",
        "tombstone_id",
        "requested_by_record_id",
        "requested_at"
      ],
      "title": "AssertionDerivedRebuildWork",
      "type": "object"
    },
    "AssertionMetadata": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "correction_target_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correction Target Id"
        },
        "epistemic_status": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "predicate": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Predicate",
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "source_authority": {
          "$ref": "#/$defs/TrustLabel"
        },
        "status": {
          "$ref": "#/$defs/AssertionStatus"
        },
        "subject_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Subject Id",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "assertion_id",
        "subject_id",
        "predicate",
        "epistemic_status",
        "status",
        "confidence",
        "source_authority",
        "sensitivity",
        "observed_at"
      ],
      "title": "AssertionMetadata",
      "type": "object"
    },
    "AssertionStateProjection": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "changed_by_record_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Changed By Record Id",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "current_status": {
          "$ref": "#/$defs/AssertionStatus"
        },
        "preferred_assertion_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Assertion Id"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "assertion_id",
        "current_status",
        "changed_by_record_id",
        "changed_at",
        "version"
      ],
      "title": "AssertionStateProjection",
      "type": "object"
    },
    "AssertionStatus": {
      "enum": [
        "provisional",
        "active",
        "confirmed",
        "disputed",
        "superseded",
        "retracted",
        "expired"
      ],
      "title": "AssertionStatus",
      "type": "string"
    },
    "BackupExpiryDisclosure": {
      "additionalProperties": false,
      "properties": {
        "latest_snapshot_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Snapshot At"
        },
        "maximum_retention_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Retention Seconds"
        },
        "state": {
          "$ref": "#/$defs/BackupExpiryState"
        },
        "status_reason": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Status Reason",
          "type": "string"
        }
      },
      "required": [
        "state",
        "status_reason"
      ],
      "title": "BackupExpiryDisclosure",
      "type": "object"
    },
    "BackupExpiryState": {
      "enum": [
        "configured",
        "not-configured",
        "unknown"
      ],
      "title": "BackupExpiryState",
      "type": "string"
    },
    "EpistemicStatus": {
      "enum": [
        "observation",
        "interpretation",
        "belief",
        "owner_confirmed",
        "correction"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "TrustLabel": {
      "enum": [
        "owner_authored",
        "trusted_system",
        "trusted_capability_metadata",
        "untrusted_external",
        "untrusted_sensor_derived",
        "model_generated",
        "generated_code",
        "signed_system_artifact"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/assertion-content-deletion-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertion": {
      "$ref": "#/$defs/AssertionMetadata"
    },
    "backup_expiry": {
      "$ref": "#/$defs/BackupExpiryDisclosure"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created": {
      "title": "Created",
      "type": "boolean"
    },
    "current_state": {
      "$ref": "#/$defs/AssertionStateProjection"
    },
    "rebuild_work": {
      "$ref": "#/$defs/AssertionDerivedRebuildWork"
    },
    "tombstone": {
      "$ref": "#/$defs/AssertionContentDeletionTombstone"
    }
  },
  "required": [
    "assertion",
    "current_state",
    "tombstone",
    "rebuild_work",
    "backup_expiry",
    "created"
  ],
  "title": "AssertionContentDeletionResult",
  "type": "object"
}
