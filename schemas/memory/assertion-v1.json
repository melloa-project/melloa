{
  "$defs": {
    "AssertionStatus": {
      "enum": [
        "provisional",
        "active",
        "confirmed",
        "disputed",
        "superseded",
        "retracted",
        "expired"
      ],
      "title": "AssertionStatus",
      "type": "string"
    },
    "EpistemicStatus": {
      "enum": [
        "observation",
        "interpretation",
        "belief",
        "owner_confirmed",
        "correction"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "TrustLabel": {
      "enum": [
        "owner_authored",
        "trusted_system",
        "trusted_capability_metadata",
        "untrusted_external",
        "untrusted_sensor_derived",
        "model_generated",
        "generated_code",
        "signed_system_artifact"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/assertion.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertion_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Assertion Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "correction_target_id": {
      "anyOf": [
        {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correction Target Id"
    },
    "epistemic_status": {
      "$ref": "#/$defs/EpistemicStatus"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "predicate": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Predicate",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "source_authority": {
      "$ref": "#/$defs/TrustLabel"
    },
    "status": {
      "$ref": "#/$defs/AssertionStatus"
    },
    "subject_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Subject Id",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "value": {
      "additionalProperties": true,
      "title": "Value",
      "type": "object"
    }
  },
  "required": [
    "assertion_id",
    "subject_id",
    "predicate",
    "value",
    "epistemic_status",
    "status",
    "confidence",
    "source_authority",
    "sensitivity",
    "observed_at"
  ],
  "title": "Assertion",
  "type": "object"
}
