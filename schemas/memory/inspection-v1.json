{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "correction_target_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correction Target Id"
        },
        "epistemic_status": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "predicate": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Predicate",
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "source_authority": {
          "$ref": "#/$defs/TrustLabel"
        },
        "status": {
          "$ref": "#/$defs/AssertionStatus"
        },
        "subject_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Subject Id",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "value": {
          "additionalProperties": true,
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "assertion_id",
        "subject_id",
        "predicate",
        "value",
        "epistemic_status",
        "status",
        "confidence",
        "source_authority",
        "sensitivity",
        "observed_at"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "AssertionStateChange": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "change_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Change Id",
          "type": "string"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "changed_by_record_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Changed By Record Id",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "new_status": {
          "$ref": "#/$defs/AssertionStatus"
        },
        "preferred_assertion_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Assertion Id"
        },
        "previous_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssertionStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Reason",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "change_id",
        "assertion_id",
        "previous_status",
        "new_status",
        "changed_by_record_id",
        "reason",
        "changed_at",
        "version"
      ],
      "title": "AssertionStateChange",
      "type": "object"
    },
    "AssertionStateProjection": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "changed_by_record_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Changed By Record Id",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "current_status": {
          "$ref": "#/$defs/AssertionStatus"
        },
        "preferred_assertion_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Assertion Id"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "assertion_id",
        "current_status",
        "changed_by_record_id",
        "changed_at",
        "version"
      ],
      "title": "AssertionStateProjection",
      "type": "object"
    },
    "AssertionStatus": {
      "enum": [
        "provisional",
        "active",
        "confirmed",
        "disputed",
        "superseded",
        "retracted",
        "expired"
      ],
      "title": "AssertionStatus",
      "type": "string"
    },
    "EpistemicStatus": {
      "enum": [
        "observation",
        "interpretation",
        "belief",
        "owner_confirmed",
        "correction"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "ProvenanceEdge": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "edge_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Edge Id",
          "type": "string"
        },
        "from_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "From Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "producer_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "Producer Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/ProvenanceRelation"
        },
        "to_id": {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "title": "To Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "from_id",
        "to_id",
        "relation",
        "created_at",
        "producer_id"
      ],
      "title": "ProvenanceEdge",
      "type": "object"
    },
    "ProvenanceRelation": {
      "enum": [
        "derived_from",
        "supports",
        "contradicts",
        "supersedes",
        "corrects",
        "cites"
      ],
      "title": "ProvenanceRelation",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "TrustLabel": {
      "enum": [
        "owner_authored",
        "trusted_system",
        "trusted_capability_metadata",
        "untrusted_external",
        "untrusted_sensor_derived",
        "model_generated",
        "generated_code",
        "signed_system_artifact"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/memory-inspection.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertion": {
      "$ref": "#/$defs/Assertion"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "current_state": {
      "$ref": "#/$defs/AssertionStateProjection"
    },
    "provenance_edges": {
      "items": {
        "$ref": "#/$defs/ProvenanceEdge"
      },
      "title": "Provenance Edges",
      "type": "array"
    },
    "state_changes": {
      "items": {
        "$ref": "#/$defs/AssertionStateChange"
      },
      "minItems": 1,
      "title": "State Changes",
      "type": "array"
    }
  },
  "required": [
    "assertion",
    "current_state",
    "provenance_edges",
    "state_changes"
  ],
  "title": "MemoryInspection",
  "type": "object"
}
