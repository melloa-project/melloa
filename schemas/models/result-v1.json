{
  "$defs": {
    "ModelAttemptOutcome": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "ModelAttemptOutcome",
      "type": "string"
    },
    "ModelRouteAttempt": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "external_disclosure": {
          "title": "External Disclosure",
          "type": "boolean"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ModelAttemptOutcome"
        },
        "processing_location": {
          "$ref": "#/$defs/ProcessingLocation"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "route_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Route Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "provider_id",
        "model_id",
        "processing_location",
        "outcome",
        "started_at",
        "completed_at",
        "external_disclosure"
      ],
      "title": "ModelRouteAttempt",
      "type": "object"
    },
    "ProcessingLocation": {
      "enum": [
        "device",
        "private_network",
        "approved_provider"
      ],
      "title": "ProcessingLocation",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/model-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelRouteAttempt"
      },
      "title": "Attempts",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "cost_gbp": {
      "minimum": 0.0,
      "title": "Cost Gbp",
      "type": "number"
    },
    "external_disclosure": {
      "title": "External Disclosure",
      "type": "boolean"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "model_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Provider Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Request Id",
      "type": "string"
    },
    "result_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Result Id",
      "type": "string"
    },
    "route_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Route Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "request_id",
    "route_id",
    "provider_id",
    "model_id",
    "output",
    "input_tokens",
    "output_tokens",
    "cost_gbp",
    "started_at",
    "completed_at",
    "external_disclosure"
  ],
  "title": "ModelResult",
  "type": "object"
}
