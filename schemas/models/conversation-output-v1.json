{
  "$id": "https://schemas.melloa.dev/v1/conversation-model-output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "citation_ids": {
      "default": [],
      "items": {
        "maxLength": 65,
        "minLength": 35,
        "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Citation Ids",
      "type": "array"
    },
    "text": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "text"
  ],
  "title": "ConversationModelOutput",
  "type": "object"
}
