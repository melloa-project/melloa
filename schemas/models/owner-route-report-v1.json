{
  "$defs": {
    "ModelGatewayHealth": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ModelRouteHealthState"
        }
      },
      "required": [
        "state",
        "checked_at",
        "reason_code"
      ],
      "title": "ModelGatewayHealth",
      "type": "object"
    },
    "ModelRouteHealthState": {
      "enum": [
        "healthy",
        "degraded",
        "unavailable",
        "unknown"
      ],
      "title": "ModelRouteHealthState",
      "type": "string"
    },
    "ModelRouteKind": {
      "enum": [
        "synthetic",
        "openai_compatible",
        "cli_agent",
        "acp_agent"
      ],
      "title": "ModelRouteKind",
      "type": "string"
    },
    "ModelRouteStatus": {
      "additionalProperties": false,
      "properties": {
        "allowed_sensitivities": {
          "items": {
            "$ref": "#/$defs/Sensitivity"
          },
          "minItems": 1,
          "title": "Allowed Sensitivities",
          "type": "array"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "estimated_max_cost_gbp": {
          "minimum": 0.0,
          "title": "Estimated Max Cost Gbp",
          "type": "number"
        },
        "external_disclosure": {
          "title": "External Disclosure",
          "type": "boolean"
        },
        "health": {
          "$ref": "#/$defs/ModelGatewayHealth"
        },
        "max_input_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "processing_location": {
          "$ref": "#/$defs/ProcessingLocation"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_retention_policies": {
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Provider Retention Policies",
          "type": "array"
        },
        "quality_profiles": {
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Quality Profiles",
          "type": "array"
        },
        "reliability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reliability",
          "type": "number"
        },
        "route_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Route Id",
          "type": "string"
        },
        "route_kind": {
          "$ref": "#/$defs/ModelRouteKind"
        },
        "supported_modalities": {
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Modalities",
          "type": "array"
        },
        "timeout_ms": {
          "exclusiveMinimum": 0,
          "maximum": 3600000,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "route_id",
        "display_name",
        "route_kind",
        "provider_id",
        "model_id",
        "processing_location",
        "external_disclosure",
        "supported_modalities",
        "quality_profiles",
        "allowed_sensitivities",
        "provider_retention_policies",
        "max_input_tokens",
        "max_output_tokens",
        "reliability",
        "timeout_ms",
        "estimated_max_cost_gbp",
        "health"
      ],
      "title": "ModelRouteStatus",
      "type": "object"
    },
    "ProcessingLocation": {
      "enum": [
        "device",
        "private_network",
        "approved_provider"
      ],
      "title": "ProcessingLocation",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/owner-model-route-report.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Owner Id",
      "type": "string"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/ModelRouteStatus"
      },
      "minItems": 1,
      "title": "Routes",
      "type": "array"
    }
  },
  "required": [
    "owner_id",
    "generated_at",
    "routes"
  ],
  "title": "OwnerModelRouteReport",
  "type": "object"
}
