{
  "$defs": {
    "ProcessingLocation": {
      "enum": [
        "device",
        "private_network",
        "approved_provider"
      ],
      "title": "ProcessingLocation",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/registered-model-route.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_sensitivities": {
      "items": {
        "$ref": "#/$defs/Sensitivity"
      },
      "minItems": 1,
      "title": "Allowed Sensitivities",
      "type": "array",
      "uniqueItems": true
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "estimated_max_cost_gbp": {
      "minimum": 0.0,
      "title": "Estimated Max Cost Gbp",
      "type": "number"
    },
    "external_disclosure": {
      "title": "External Disclosure",
      "type": "boolean"
    },
    "max_input_tokens": {
      "exclusiveMinimum": 0,
      "title": "Max Input Tokens",
      "type": "integer"
    },
    "max_output_tokens": {
      "exclusiveMinimum": 0,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "model_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "priority": {
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "processing_location": {
      "$ref": "#/$defs/ProcessingLocation"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Provider Id",
      "type": "string"
    },
    "provider_retention_policies": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Provider Retention Policies",
      "type": "array",
      "uniqueItems": true
    },
    "quality_profiles": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Quality Profiles",
      "type": "array",
      "uniqueItems": true
    },
    "reliability": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Reliability",
      "type": "number"
    },
    "route_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Route Id",
      "type": "string"
    },
    "supported_modalities": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Modalities",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "route_id",
    "provider_id",
    "model_id",
    "processing_location",
    "supported_modalities",
    "quality_profiles",
    "allowed_sensitivities",
    "provider_retention_policies",
    "max_input_tokens",
    "max_output_tokens",
    "estimated_max_cost_gbp",
    "reliability",
    "priority",
    "external_disclosure"
  ],
  "title": "RegisteredModelRoute",
  "type": "object"
}
