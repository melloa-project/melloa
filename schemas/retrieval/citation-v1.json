{
  "$defs": {
    "AssertionStatus": {
      "enum": [
        "provisional",
        "active",
        "confirmed",
        "disputed",
        "superseded",
        "retracted",
        "expired"
      ],
      "title": "AssertionStatus",
      "type": "string"
    },
    "EpistemicStatus": {
      "enum": [
        "observation",
        "interpretation",
        "belief",
        "owner_confirmed",
        "correction"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "personal",
        "sensitive",
        "highly_sensitive",
        "device_only"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "TrustLabel": {
      "enum": [
        "owner_authored",
        "trusted_system",
        "trusted_capability_metadata",
        "untrusted_external",
        "untrusted_sensor_derived",
        "model_generated",
        "generated_code",
        "signed_system_artifact"
      ],
      "title": "TrustLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/memory-citation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertion_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Assertion Id",
      "type": "string"
    },
    "assertion_status": {
      "$ref": "#/$defs/AssertionStatus"
    },
    "citation_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Citation Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "epistemic_status": {
      "$ref": "#/$defs/EpistemicStatus"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "predicate": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Predicate",
      "type": "string"
    },
    "provenance_edge_ids": {
      "items": {
        "maxLength": 65,
        "minLength": 35,
        "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Provenance Edge Ids",
      "type": "array"
    },
    "rank_reasons": {
      "items": {
        "maxLength": 128,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Rank Reasons",
      "type": "array"
    },
    "rank_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rank Score",
      "type": "number"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "source_authority": {
      "$ref": "#/$defs/TrustLabel"
    },
    "value": {
      "additionalProperties": true,
      "title": "Value",
      "type": "object"
    }
  },
  "required": [
    "citation_id",
    "assertion_id",
    "predicate",
    "value",
    "epistemic_status",
    "assertion_status",
    "confidence",
    "source_authority",
    "sensitivity",
    "observed_at",
    "provenance_edge_ids",
    "rank_score",
    "rank_reasons"
  ],
  "title": "MemoryCitation",
  "type": "object"
}
