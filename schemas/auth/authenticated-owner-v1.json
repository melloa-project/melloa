{
  "$id": "https://schemas.melloa.dev/v1/authenticated-owner.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticated_at": {
      "format": "date-time",
      "title": "Authenticated At",
      "type": "string"
    },
    "authentication_method": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Authentication Method",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Owner Id",
      "type": "string"
    },
    "reauthenticated_until": {
      "format": "date-time",
      "title": "Reauthenticated Until",
      "type": "string"
    },
    "session_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "session_id",
    "authentication_method",
    "authenticated_at",
    "reauthenticated_until",
    "expires_at"
  ],
  "title": "AuthenticatedOwner",
  "type": "object"
}
