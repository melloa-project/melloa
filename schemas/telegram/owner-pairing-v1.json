{
  "$id": "https://schemas.melloa.dev/v1/telegram-owner-pairing.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "confirmed_at": {
      "format": "date-time",
      "title": "Confirmed At",
      "type": "string"
    },
    "confirmed_by_owner_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Confirmed By Owner Id",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Owner Id",
      "type": "string"
    },
    "pairing_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Pairing Id",
      "type": "string"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    },
    "telegram_chat_id": {
      "maximum": 4503599627370495,
      "minimum": 1,
      "title": "Telegram Chat Id",
      "type": "integer"
    },
    "telegram_user_id": {
      "maximum": 4503599627370495,
      "minimum": 1,
      "title": "Telegram User Id",
      "type": "integer"
    }
  },
  "required": [
    "pairing_id",
    "candidate_id",
    "owner_id",
    "telegram_user_id",
    "telegram_chat_id",
    "confirmed_by_owner_id",
    "confirmed_at"
  ],
  "title": "TelegramOwnerPairing",
  "type": "object"
}
