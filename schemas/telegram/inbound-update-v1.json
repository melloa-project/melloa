{
  "$defs": {
    "TelegramAttachmentKind": {
      "enum": [
        "photo",
        "document",
        "audio",
        "voice",
        "video",
        "animation",
        "sticker",
        "unsupported"
      ],
      "title": "TelegramAttachmentKind",
      "type": "string"
    },
    "TelegramAttachmentReference": {
      "additionalProperties": false,
      "properties": {
        "declared_size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Size Bytes"
        },
        "file_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "file_name": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Name"
        },
        "file_unique_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "File Unique Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TelegramAttachmentKind"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        }
      },
      "required": [
        "kind",
        "file_id",
        "file_unique_id"
      ],
      "title": "TelegramAttachmentReference",
      "type": "object"
    },
    "TelegramChatType": {
      "enum": [
        "private",
        "group",
        "supergroup",
        "channel"
      ],
      "title": "TelegramChatType",
      "type": "string"
    },
    "TelegramInboundMessage": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TelegramAttachmentReference"
          },
          "maxItems": 16,
          "title": "Attachments",
          "type": "array"
        },
        "chat_id": {
          "maximum": 4503599627370495,
          "minimum": -4503599627370495,
          "title": "Chat Id",
          "type": "integer"
        },
        "chat_type": {
          "$ref": "#/$defs/TelegramChatType"
        },
        "sender_user_id": {
          "maximum": 4503599627370495,
          "minimum": 1,
          "title": "Sender User Id",
          "type": "integer"
        },
        "sent_at": {
          "format": "date-time",
          "title": "Sent At",
          "type": "string"
        },
        "telegram_message_id": {
          "maximum": 4503599627370495,
          "minimum": 1,
          "title": "Telegram Message Id",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "telegram_message_id",
        "sender_user_id",
        "chat_id",
        "chat_type",
        "sent_at"
      ],
      "title": "TelegramInboundMessage",
      "type": "object"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/telegram-inbound-update.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "kind": {
      "const": "message",
      "default": "message",
      "title": "Kind",
      "type": "string"
    },
    "message": {
      "$ref": "#/$defs/TelegramInboundMessage"
    },
    "raw_size_bytes": {
      "maximum": 262144,
      "minimum": 1,
      "title": "Raw Size Bytes",
      "type": "integer"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "source_payload_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Payload Hash",
      "type": "string"
    },
    "update_id": {
      "maximum": 4503599627370495,
      "minimum": 0,
      "title": "Update Id",
      "type": "integer"
    }
  },
  "required": [
    "update_id",
    "message",
    "received_at",
    "raw_size_bytes",
    "source_payload_hash"
  ],
  "title": "TelegramInboundUpdate",
  "type": "object"
}
