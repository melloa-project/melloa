{
  "$defs": {
    "TelegramAttachmentDisposition": {
      "enum": [
        "rejected",
        "quarantined"
      ],
      "title": "TelegramAttachmentDisposition",
      "type": "string"
    },
    "TelegramAttachmentReceipt": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/TelegramAttachmentDisposition"
        },
        "file_unique_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "File Unique Id",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "quarantine_blob_id": {
          "anyOf": [
            {
              "maxLength": 65,
              "minLength": 35,
              "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quarantine Blob Id"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "file_unique_id",
        "disposition",
        "recorded_at"
      ],
      "title": "TelegramAttachmentReceipt",
      "type": "object"
    },
    "TelegramUpdateDisposition": {
      "enum": [
        "ingested",
        "rejected",
        "pairing_candidate"
      ],
      "title": "TelegramUpdateDisposition",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/telegram-ingestion-receipt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "attachment_receipts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TelegramAttachmentReceipt"
      },
      "title": "Attachment Receipts",
      "type": "array"
    },
    "canonical_message_id": {
      "anyOf": [
        {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Message Id"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/TelegramUpdateDisposition"
    },
    "pairing_candidate_id": {
      "anyOf": [
        {
          "maxLength": 65,
          "minLength": 35,
          "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pairing Candidate Id"
    },
    "reason_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "receipt_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "update_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Update Fingerprint",
      "type": "string"
    },
    "update_id": {
      "maximum": 4503599627370495,
      "minimum": 0,
      "title": "Update Id",
      "type": "integer"
    }
  },
  "required": [
    "receipt_id",
    "adapter_id",
    "update_id",
    "update_fingerprint",
    "disposition",
    "recorded_at"
  ],
  "title": "TelegramIngestionReceipt",
  "type": "object"
}
