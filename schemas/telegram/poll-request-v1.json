{
  "$defs": {
    "TelegramUpdateKind": {
      "enum": [
        "message"
      ],
      "title": "TelegramUpdateKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.melloa.dev/v1/telegram-poll-request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "allowed_updates": {
      "default": [
        "message"
      ],
      "items": {
        "$ref": "#/$defs/TelegramUpdateKind"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Allowed Updates",
      "type": "array"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "limit": {
      "default": 100,
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "offset": {
      "maximum": 4503599627370496,
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "timeout_seconds": {
      "maximum": 50,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "adapter_id",
    "offset",
    "timeout_seconds"
  ],
  "title": "TelegramPollRequest",
  "type": "object"
}
