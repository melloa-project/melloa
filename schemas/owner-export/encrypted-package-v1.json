{
  "$id": "https://schemas.melloa.dev/v1/encrypted-export-package.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cipher": {
      "const": "aes-256-gcm",
      "default": "aes-256-gcm",
      "title": "Cipher",
      "type": "string"
    },
    "ciphertext_size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Ciphertext Size Bytes",
      "type": "integer"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "inner_export_id": {
      "maxLength": 65,
      "minLength": 35,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[0-9a-f]{32}$",
      "title": "Inner Export Id",
      "type": "string"
    },
    "inner_format_id": {
      "default": "melloa.canonical-owner-export",
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Inner Format Id",
      "type": "string"
    },
    "kdf": {
      "const": "scrypt",
      "default": "scrypt",
      "title": "Kdf",
      "type": "string"
    },
    "nonce_b64": {
      "maxLength": 32,
      "minLength": 16,
      "title": "Nonce B64",
      "type": "string"
    },
    "package_format_id": {
      "default": "melloa.encrypted-owner-export-package",
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Package Format Id",
      "type": "string"
    },
    "package_format_version": {
      "default": "1.0.0",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Package Format Version",
      "type": "string"
    },
    "plaintext_zip_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plaintext Zip Hash",
      "type": "string"
    },
    "plaintext_zip_size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Plaintext Zip Size Bytes",
      "type": "integer"
    },
    "salt_b64": {
      "maxLength": 64,
      "minLength": 22,
      "title": "Salt B64",
      "type": "string"
    },
    "scrypt_n": {
      "maximum": 1048576,
      "minimum": 16384,
      "title": "Scrypt N",
      "type": "integer"
    },
    "scrypt_p": {
      "maximum": 16,
      "minimum": 1,
      "title": "Scrypt P",
      "type": "integer"
    },
    "scrypt_r": {
      "maximum": 64,
      "minimum": 1,
      "title": "Scrypt R",
      "type": "integer"
    }
  },
  "required": [
    "created_at",
    "inner_export_id",
    "scrypt_n",
    "scrypt_r",
    "scrypt_p",
    "salt_b64",
    "nonce_b64",
    "plaintext_zip_hash",
    "plaintext_zip_size_bytes",
    "ciphertext_size_bytes"
  ],
  "title": "EncryptedExportPackageHeader",
  "type": "object"
}
